<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>docs-index</AssemblyName>
    <RootNamespace>DocsMcpSample</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Repl/Repl.csproj" />
    <ProjectReference Include="../../src/Repl.Mcp/Repl.Mcp.csproj" />
    <ProjectReference Include="../../src/Repl.Remote.Defaults/Repl.Remote.Defaults.csproj" />
    <ProjectReference Include="../../src/Repl.WebSocket/Repl.WebSocket.csproj" />
    <ProjectReference Include="../../src/Repl.Spectre/Repl.Spectre.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <InternalsVisibleTo Include="Repl.DocsSampleTests" />
    <Content Update="assets.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../shared/terminal-client.js" Link="wwwroot/terminal-client.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../shared/SessionLifetime.cs" Link="Hosting/SessionLifetime.cs" />
    <Compile Include="../shared/RemoteClient.cs" Link="Hosting/RemoteClient.cs" />
  </ItemGroup>
</Project>
