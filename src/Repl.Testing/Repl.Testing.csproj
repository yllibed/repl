<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Unlike the test projects that share this override, this one is a shipped package: without a
		     documentation file its consumers get no IntelliSense on its public API. Keeping generation on
		     also keeps CS1591 armed, so a new public member cannot ship undocumented. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Description>In-memory multi-session testing toolkit for Repl applications.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Repl.Defaults\Repl.Defaults.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
