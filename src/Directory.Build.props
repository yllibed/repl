<Project>

	<PropertyGroup>
		<!-- Target list for the projects that opt in through $(ReplTargetFrameworks). -->
		<ReplTargetFrameworks>net10.0;net11.0</ReplTargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Quality gate: keep warnings at zero (as much as practical). -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Deterministic>true</Deterministic>
		<DeterministicSourcePaths>true</DeterministicSourcePaths>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<DebugType>portable</DebugType>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<EmbedAllSources>true</EmbedAllSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/yllibed/repl</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageProjectUrl>https://repl.yllibed.org/</PackageProjectUrl>
		<!-- Pack fails on a breaking change against the last release. Move the baseline to each release as it ships. -->
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.12.1</PackageValidationBaselineVersion>
		<Authors>Carl de Billy</Authors>
		<PackageTags>repl;cli;command-line;terminal;interactive-shell;automation;dotnet;csharp;mcp;model-context-protocol;ai-agents;developer-tools</PackageTags>
	</PropertyGroup>

	<!--
		.NET 11 adds cancellable TextWriter.WriteAsync/WriteLineAsync overloads, so CA2016 asks to forward the token to
		every write that has one in scope. Doing so changes behaviour on net11.0 only: a token that is already
		cancelled makes the write throw OperationCanceledException instead of completing. Keeping both targets
		identical comes first, so the rule stays off on net11.0 until each write has been judged on its own.
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<NoWarn>$(NoWarn);CA2016</NoWarn>
	</PropertyGroup>

	<!--
		Runtime async, on request only (-p:ReplRuntimeAsync=true): the runtime runs async methods itself instead of
		compiler-generated state machines. Packages never ship with it: .NET 11 WebAssembly runs on Mono, which
		does not support it, and Microsoft keeps its own NuGet packages off it for that reason
		(dotnet/runtime#125406, dotnet/aspnetcore#66200). The Runtime Async CI job tests Repl with it, ready for
		when packages can ship with it. net11.0 and later: on net10.0 it is a preview feature and fails the build
		with SYSLIB5007.
	-->
	<PropertyGroup Condition="'$(ReplRuntimeAsync)' == 'true' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
		<Features>$(Features);runtime-async=on</Features>
		<DefineConstants>$(DefineConstants);REPL_RUNTIME_ASYNC</DefineConstants>
	</PropertyGroup>

	<Target Name="ReplRefuseRuntimeAsyncPackage" BeforeTargets="GenerateNuspec" Condition="'$(ReplRuntimeAsync)' == 'true'">
		<Error Text="$(MSBuildProjectName): packages are never built with ReplRuntimeAsync=true (see src/Directory.Build.props). Pack from a build without it." />
	</Target>

	<!-- Reproducible build — enable only under CI to preserve local debug paths -->
	<PropertyGroup Condition="'$(CI)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
		<!-- Meziantou Analyzer with default configuration (no custom rule overrides here). -->
		<PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
	</ItemGroup>

</Project>
